    { "name": "Commandes", "url": "/admin/commandes", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192" }] },
    { "name": "Paiements", "url": "/admin/paiements", "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192" }] }
  ]
